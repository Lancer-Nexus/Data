#include <windows.h>


STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
{
  0, "Entered %Zv1."    // or just "%Z" if you prefer, e.g.:
  1, "Left %Zv1."       // "Entered the Badlands." vs "Badlands".
}


VS_VERSION_INFO VERSIONINFO
FILEVERSION	1,2,0,0
PRODUCTVERSION	1,2,0,0
FILEOS		VOS__WINDOWS32
FILETYPE	VFT_DLL
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904B0"
    {
      VALUE "Comments",         "http://freelancer.adoxa.vze.com/"
      VALUE "CompanyName",      "Jason Hood"
      VALUE "FileDescription",  "Zone"
      VALUE "FileVersion",      "1.20"
      VALUE "InternalName",     "Zone"
      VALUE "LegalCopyright",   "None"
      VALUE "OriginalFilename", "Zone.dll"
      VALUE "ProductName",      "Freelancer"
      VALUE "ProductVersion",   "1, 0, 0, 0"
    }
  }

  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x0409, 0x04B0
  }
}
